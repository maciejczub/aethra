; Aethra installer (NSIS 3). Built by tools/build_windows_bundle.py --installer:
;   makensis -DVERSION=<version> -DSOURCE=<bundle folder> -DOUTFILE=<installer.exe> aethra.nsi
;
; Per-user installation, no administrator rights needed. An update keeps the
; show: show.yaml, media\ and logs\ are never overwritten or removed.

Unicode true
!include "MUI2.nsh"
!include "LogicLib.nsh"

Name "Aethra ${VERSION}"
OutFile "${OUTFILE}"
InstallDir "$PROFILE\Aethra"
InstallDirRegKey HKCU "Software\Aethra" "InstallDir"
RequestExecutionLevel user
SetCompressor /SOLID lzma
BrandingText "Aethra ${VERSION}"

!define UNINSTALL_KEY "Software\Microsoft\Windows\CurrentVersion\Uninstall\Aethra"
!define MUI_ABORTWARNING
!define MUI_ICON "${SOURCE}\aethra.ico"
!define MUI_UNICON "${SOURCE}\aethra.ico"
!define MUI_WELCOMEPAGE_TEXT "This installs Aethra ${VERSION}, the stage video player, for the current user.$\r$\n$\r$\nNo administrator rights are needed. Updating an existing installation keeps your show file (show.yaml), your clips (media) and the logs."
!define MUI_FINISHPAGE_RUN
!define MUI_FINISHPAGE_RUN_TEXT "Open the Aethra control panel"
!define MUI_FINISHPAGE_RUN_FUNCTION OpenPanel
!define MUI_FINISHPAGE_SHOWREADME "$INSTDIR\docs\control-panel.md"
!define MUI_FINISHPAGE_SHOWREADME_TEXT "Read about the control panel"
!define MUI_FINISHPAGE_SHOWREADME_NOTCHECKED

!insertmacro MUI_PAGE_WELCOME
!insertmacro MUI_PAGE_LICENSE "${SOURCE}\LICENSE.txt"
!insertmacro MUI_PAGE_COMPONENTS
!insertmacro MUI_PAGE_DIRECTORY
!insertmacro MUI_PAGE_INSTFILES
!insertmacro MUI_PAGE_FINISH
!insertmacro MUI_UNPAGE_CONFIRM
!insertmacro MUI_UNPAGE_INSTFILES
!insertmacro MUI_LANGUAGE "English"

Function OpenPanel
  SetOutPath "$INSTDIR"
  Exec '"$INSTDIR\python\pythonw.exe" -X utf8 -m aethra gui "$INSTDIR\show.yaml"'
FunctionEnd

!macro RefuseIfRunning EXE
  ${If} ${FileExists} "${EXE}"
    ClearErrors
    FileOpen $0 "${EXE}" a
    ${If} ${Errors}
      MessageBox MB_ICONSTOP "Aethra is running (the show or the control panel).$\r$\nQuit it first, then run the installer again." /SD IDOK
      Abort
    ${EndIf}
    FileClose $0
  ${EndIf}
!macroend

Function .onInit
  ; A running show or panel keeps python.exe open: replacing it would fail half-way.
  !insertmacro RefuseIfRunning "$INSTDIR\python\python.exe"
  !insertmacro RefuseIfRunning "$INSTDIR\python\pythonw.exe"
FunctionEnd

Section "Aethra (required)" SecMain
  SectionIn RO
  SetOutPath "$INSTDIR"
  ; Program files are replaced as a whole (no leftovers of an older version).
  RMDir /r "$INSTDIR\python"
  RMDir /r "$INSTDIR\src"
  RMDir /r "$INSTDIR\mpv"
  RMDir /r "$INSTDIR\docs"
  RMDir /r "$INSTDIR\scripts"
  File /r "${SOURCE}\python"
  File /r "${SOURCE}\src"
  File /r "${SOURCE}\mpv"
  File /r "${SOURCE}\docs"
  File /r "${SOURCE}\scripts"
  File "${SOURCE}\Aethra.cmd"
  File "${SOURCE}\README.md"
  File "${SOURCE}\LICENSE.txt"
  File "${SOURCE}\THIRD-PARTY.txt"
  File "${SOURCE}\VERSION.txt"
  File "${SOURCE}\aethra.ico"
  File "${SOURCE}\show.example.yaml"
  ; The show file only on a first installation.
  SetOverwrite off
  File "/oname=show.yaml" "${SOURCE}\show.example.yaml"
  SetOverwrite on
  CreateDirectory "$INSTDIR\media"
  CreateDirectory "$INSTDIR\logs"

  WriteUninstaller "$INSTDIR\Uninstall.exe"
  WriteRegStr HKCU "Software\Aethra" "InstallDir" "$INSTDIR"
  WriteRegStr HKCU "${UNINSTALL_KEY}" "DisplayName" "Aethra"
  WriteRegStr HKCU "${UNINSTALL_KEY}" "DisplayVersion" "${VERSION}"
  WriteRegStr HKCU "${UNINSTALL_KEY}" "Publisher" "Aethra"
  WriteRegStr HKCU "${UNINSTALL_KEY}" "DisplayIcon" "$INSTDIR\aethra.ico"
  WriteRegStr HKCU "${UNINSTALL_KEY}" "InstallLocation" "$INSTDIR"
  WriteRegStr HKCU "${UNINSTALL_KEY}" "UninstallString" '"$INSTDIR\Uninstall.exe"'
  WriteRegStr HKCU "${UNINSTALL_KEY}" "QuietUninstallString" '"$INSTDIR\Uninstall.exe" /S'
  WriteRegDWORD HKCU "${UNINSTALL_KEY}" "NoModify" 1
  WriteRegDWORD HKCU "${UNINSTALL_KEY}" "NoRepair" 1

  CreateDirectory "$SMPROGRAMS\Aethra"
  CreateShortcut "$SMPROGRAMS\Aethra\Aethra.lnk" "$INSTDIR\Aethra.cmd" '"show.yaml"' "$INSTDIR\aethra.ico" 0
  CreateShortcut "$SMPROGRAMS\Aethra\Aethra panel.lnk" "$INSTDIR\python\pythonw.exe" '-X utf8 -m aethra gui "show.yaml"' "$INSTDIR\aethra.ico" 0
  CreateShortcut "$SMPROGRAMS\Aethra\Aethra folder.lnk" "$INSTDIR"
  CreateShortcut "$SMPROGRAMS\Aethra\Uninstall Aethra.lnk" "$INSTDIR\Uninstall.exe"
SectionEnd

Section "Desktop shortcuts" SecDesktop
  SetOutPath "$INSTDIR"
  CreateShortcut "$DESKTOP\Aethra.lnk" "$INSTDIR\Aethra.cmd" '"show.yaml"' "$INSTDIR\aethra.ico" 0
  CreateShortcut "$DESKTOP\Aethra panel.lnk" "$INSTDIR\python\pythonw.exe" '-X utf8 -m aethra gui "show.yaml"' "$INSTDIR\aethra.ico" 0
SectionEnd

Section /o "Start the show after logging in" SecAutostart
  SetOutPath "$INSTDIR"
  FileOpen $0 "$INSTDIR\Aethra-autostart.cmd" w
  FileWrite $0 "@echo off$\r$\nrem Generated by the installer: waits for displays and network, then starts the show.$\r$\nset AETHRA_START_DELAY=20$\r$\ncall $\"$INSTDIR\Aethra.cmd$\" $\"show.yaml$\"$\r$\n"
  FileClose $0
  CreateShortcut "$SMSTARTUP\Aethra.lnk" "$INSTDIR\Aethra-autostart.cmd"
SectionEnd

LangString DESC_Main ${LANG_ENGLISH} "The player, its Python, mpv and the documentation."
LangString DESC_Desktop ${LANG_ENGLISH} "Aethra (starts the show) and Aethra panel (the control panel) on the desktop."
LangString DESC_Autostart ${LANG_ENGLISH} "For the show laptop: the show starts by itself 20 s after logging in."
!insertmacro MUI_FUNCTION_DESCRIPTION_BEGIN
  !insertmacro MUI_DESCRIPTION_TEXT ${SecMain} $(DESC_Main)
  !insertmacro MUI_DESCRIPTION_TEXT ${SecDesktop} $(DESC_Desktop)
  !insertmacro MUI_DESCRIPTION_TEXT ${SecAutostart} $(DESC_Autostart)
!insertmacro MUI_FUNCTION_DESCRIPTION_END

Section "Uninstall"
  ; The show stays: show.yaml, media and logs are not removed.
  RMDir /r "$INSTDIR\python"
  RMDir /r "$INSTDIR\src"
  RMDir /r "$INSTDIR\mpv"
  RMDir /r "$INSTDIR\docs"
  RMDir /r "$INSTDIR\scripts"
  Delete "$INSTDIR\Aethra.cmd"
  Delete "$INSTDIR\Aethra-autostart.cmd"
  Delete "$INSTDIR\README.md"
  Delete "$INSTDIR\LICENSE.txt"
  Delete "$INSTDIR\THIRD-PARTY.txt"
  Delete "$INSTDIR\VERSION.txt"
  Delete "$INSTDIR\aethra.ico"
  Delete "$INSTDIR\show.example.yaml"
  Delete "$INSTDIR\Uninstall.exe"
  RMDir "$INSTDIR\logs"
  RMDir "$INSTDIR\media"
  RMDir "$INSTDIR"
  Delete "$DESKTOP\Aethra.lnk"
  Delete "$DESKTOP\Aethra panel.lnk"
  Delete "$SMSTARTUP\Aethra.lnk"
  RMDir /r "$SMPROGRAMS\Aethra"
  DeleteRegKey HKCU "${UNINSTALL_KEY}"
  DeleteRegKey HKCU "Software\Aethra"
SectionEnd
